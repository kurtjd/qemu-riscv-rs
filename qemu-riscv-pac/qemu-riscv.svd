<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1"
  xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
  xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>qemu.org</vendor>
  <name>QEMU_RISCV_VIRT</name>
  <series>RISC-V</series>
  <version>0.1</version>
  <description>QEMU RISC-V Virt Machine Platform</description>

  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>

  <cpu>
    <name>riscv</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>0</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>

  <peripherals>

    <!-- ================================================================ -->
    <!-- CLINT - Core Local Interruptor                                   -->
    <!-- ================================================================ -->
    <peripheral>
      <name>CLINT</name>
      <description>Core Local Interruptor (SiFive CLINT compatible)</description>
      <baseAddress>0x02000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x10000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>MSIP</name>
          <description>Machine Software Interrupt Pending for hart 0</description>
          <addressOffset>0x0000</addressOffset>
          <fields>
            <field>
              <name>MSIP</name>
              <description>Machine software interrupt pending</description>
              <bitRange>[0:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>MTIMECMP_LO</name>
          <description>Machine timer compare low word for hart 0</description>
          <addressOffset>0x4000</addressOffset>
        </register>
        <register>
          <name>MTIMECMP_HI</name>
          <description>Machine timer compare high word for hart 0</description>
          <addressOffset>0x4004</addressOffset>
        </register>
        <register>
          <name>MTIME_LO</name>
          <description>Machine timer low word</description>
          <addressOffset>0xBFF8</addressOffset>
        </register>
        <register>
          <name>MTIME_HI</name>
          <description>Machine timer high word</description>
          <addressOffset>0xBFFC</addressOffset>
        </register>
      </registers>
    </peripheral>

    <!-- ================================================================ -->
    <!-- PLIC - Platform-Level Interrupt Controller                       -->
    <!-- ================================================================ -->
    <peripheral>
      <name>PLIC</name>
      <description>Platform-Level Interrupt Controller (SiFive PLIC compatible)</description>
      <baseAddress>0x0C000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x201000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>32</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PRIORITY[%s]</name>
          <description>Priority for interrupt source %s (source 0 is reserved)</description>
          <addressOffset>0x0</addressOffset>
          <fields>
            <field>
              <name>PRIORITY</name>
              <description>Priority level (0=disabled, 1=lowest, 7=highest)</description>
              <bitRange>[2:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <dim>1</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>PENDING%s</name>
          <description>Interrupt pending bits</description>
          <addressOffset>0x1000</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <dim>1</dim>
          <dimIncrement>0x4</dimIncrement>
          <name>M_ENABLE%s</name>
          <description>M-mode interrupt enable bits (context 0)</description>
          <addressOffset>0x2000</addressOffset>
        </register>
        <register>
          <name>M_THRESHOLD</name>
          <description>M-mode priority threshold (context 0)</description>
          <addressOffset>0x200000</addressOffset>
          <fields>
            <field>
              <name>THRESHOLD</name>
              <description>Priority threshold (interrupts with priority &lt;= threshold are masked)</description>
              <bitRange>[2:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>M_CLAIM</name>
          <description>M-mode interrupt claim/complete (context 0). Read to claim, write to complete.</description>
          <addressOffset>0x200004</addressOffset>
        </register>
      </registers>
    </peripheral>

    <!-- ================================================================ -->
    <!-- UART0 - NS16550A compatible UART                                 -->
    <!-- ================================================================ -->
    <peripheral>
      <name>UART0</name>
      <description>NS16550A compatible UART</description>
      <baseAddress>0x10000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>UART0</name>
        <description>UART0 interrupt (PLIC source 1)</description>
        <value>1</value>
      </interrupt>
      <registers>
        <cluster>
          <name>DATA</name>
          <description>UART registers when DLAB=0</description>
          <headerStructName>UartData</headerStructName>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>RBR</name>
            <description>Receiver Buffer Register (DLAB=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x00</resetValue>
          </register>
          <register>
            <name>THR</name>
            <description>Transmitter Holding Register (DLAB=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>8</size>
            <access>write-only</access>
            <resetValue>0x00</resetValue>
          </register>
          <register>
            <name>IER</name>
            <description>Interrupt Enable Register (DLAB=0)</description>
            <addressOffset>0x1</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>ERBFI</name>
                <description>Enable Received Data Available Interrupt</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>ETBEI</name>
                <description>Enable Transmitter Holding Register Empty Interrupt</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>ELSI</name>
                <description>Enable Receiver Line Status Interrupt</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>EDSSI</name>
                <description>Enable Modem Status Interrupt</description>
                <bitRange>[3:3]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>IIR</name>
            <description>Interrupt Identification Register</description>
            <addressOffset>0x2</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x01</resetValue>
            <fields>
              <field>
                <name>IPEND</name>
                <description>Interrupt NOT pending (0 = interrupt pending)</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>IID</name>
                <description>Interrupt ID</description>
                <bitRange>[3:1]</bitRange>
              </field>
              <field>
                <name>FIFOEN</name>
                <description>FIFOs enabled</description>
                <bitRange>[7:6]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>FCR</name>
            <description>FIFO Control Register</description>
            <addressOffset>0x2</addressOffset>
            <size>8</size>
            <access>write-only</access>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>FIFOE</name>
                <description>FIFO enable</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>RFIFOR</name>
                <description>Receiver FIFO reset (self-clearing)</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>XFIFOR</name>
                <description>Transmitter FIFO reset (self-clearing)</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>DMAM</name>
                <description>DMA mode select</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>RFTL</name>
                <description>Receiver FIFO trigger level</description>
                <bitRange>[7:6]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>LCR</name>
            <description>Line Control Register</description>
            <addressOffset>0x3</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>WLS</name>
                <description>Word length select</description>
                <bitRange>[1:0]</bitRange>
              </field>
              <field>
                <name>STB</name>
                <description>Number of stop bits</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>PEN</name>
                <description>Parity enable</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>EPS</name>
                <description>Even parity select</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>SP</name>
                <description>Stick parity</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>BC</name>
                <description>Break control</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>DLAB</name>
                <description>Divisor latch access bit</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>MCR</name>
            <description>Modem Control Register</description>
            <addressOffset>0x4</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>DTR</name>
                <description>Data terminal ready</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>RTS</name>
                <description>Request to send</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>OUT1</name>
                <description>Output 1</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>OUT2</name>
                <description>Output 2</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>LOOP</name>
                <description>Loopback mode</description>
                <bitRange>[4:4]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>LSR</name>
            <description>Line Status Register</description>
            <addressOffset>0x5</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x60</resetValue>
            <fields>
              <field>
                <name>DR</name>
                <description>Data ready</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>OE</name>
                <description>Overrun error</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>PE</name>
                <description>Parity error</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>FE</name>
                <description>Framing error</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>BI</name>
                <description>Break interrupt</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>THRE</name>
                <description>Transmitter holding register empty</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>TEMT</name>
                <description>Transmitter empty</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>EIRF</name>
                <description>Error in receiver FIFO</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>MSR</name>
            <description>Modem Status Register</description>
            <addressOffset>0x6</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>DCTS</name>
                <description>Delta clear to send</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>DDSR</name>
                <description>Delta data set ready</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>TERI</name>
                <description>Trailing edge ring indicator</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>DDCD</name>
                <description>Delta data carrier detect</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>CTS</name>
                <description>Clear to send</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>DSR</name>
                <description>Data set ready</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>RI</name>
                <description>Ring indicator</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>DCD</name>
                <description>Data carrier detect</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>SCR</name>
            <description>Scratch Register</description>
            <addressOffset>0x7</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
          </register>
        </cluster>
        <cluster>
          <name>DLAB</name>
          <description>UART registers when DLAB=1</description>
          <alternateCluster>DATA</alternateCluster>
          <headerStructName>UartDlab</headerStructName>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>DLL</name>
            <description>Divisor Latch LSB (DLAB=1)</description>
            <addressOffset>0x0</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
          </register>
          <register>
            <name>DLM</name>
            <description>Divisor Latch MSB (DLAB=1)</description>
            <addressOffset>0x1</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
          </register>
          <register>
            <name>IIR</name>
            <description>Interrupt Identification Register</description>
            <addressOffset>0x2</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x01</resetValue>
            <fields>
              <field>
                <name>IPEND</name>
                <description>Interrupt NOT pending (0 = interrupt pending)</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>IID</name>
                <description>Interrupt ID</description>
                <bitRange>[3:1]</bitRange>
              </field>
              <field>
                <name>FIFOEN</name>
                <description>FIFOs enabled</description>
                <bitRange>[7:6]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>FCR</name>
            <description>FIFO Control Register</description>
            <addressOffset>0x2</addressOffset>
            <size>8</size>
            <access>write-only</access>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>FIFOE</name>
                <description>FIFO enable</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>RFIFOR</name>
                <description>Receiver FIFO reset (self-clearing)</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>XFIFOR</name>
                <description>Transmitter FIFO reset (self-clearing)</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>DMAM</name>
                <description>DMA mode select</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>RFTL</name>
                <description>Receiver FIFO trigger level</description>
                <bitRange>[7:6]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>LCR</name>
            <description>Line Control Register</description>
            <addressOffset>0x3</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>WLS</name>
                <description>Word length select</description>
                <bitRange>[1:0]</bitRange>
              </field>
              <field>
                <name>STB</name>
                <description>Number of stop bits</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>PEN</name>
                <description>Parity enable</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>EPS</name>
                <description>Even parity select</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>SP</name>
                <description>Stick parity</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>BC</name>
                <description>Break control</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>DLAB</name>
                <description>Divisor latch access bit</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>MCR</name>
            <description>Modem Control Register</description>
            <addressOffset>0x4</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>DTR</name>
                <description>Data terminal ready</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>RTS</name>
                <description>Request to send</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>OUT1</name>
                <description>Output 1</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>OUT2</name>
                <description>Output 2</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>LOOP</name>
                <description>Loopback mode</description>
                <bitRange>[4:4]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>LSR</name>
            <description>Line Status Register</description>
            <addressOffset>0x5</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x60</resetValue>
            <fields>
              <field>
                <name>DR</name>
                <description>Data ready</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>OE</name>
                <description>Overrun error</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>PE</name>
                <description>Parity error</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>FE</name>
                <description>Framing error</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>BI</name>
                <description>Break interrupt</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>THRE</name>
                <description>Transmitter holding register empty</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>TEMT</name>
                <description>Transmitter empty</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>EIRF</name>
                <description>Error in receiver FIFO</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>MSR</name>
            <description>Modem Status Register</description>
            <addressOffset>0x6</addressOffset>
            <size>8</size>
            <access>read-only</access>
            <resetValue>0x00</resetValue>
            <fields>
              <field>
                <name>DCTS</name>
                <description>Delta clear to send</description>
                <bitRange>[0:0]</bitRange>
              </field>
              <field>
                <name>DDSR</name>
                <description>Delta data set ready</description>
                <bitRange>[1:1]</bitRange>
              </field>
              <field>
                <name>TERI</name>
                <description>Trailing edge ring indicator</description>
                <bitRange>[2:2]</bitRange>
              </field>
              <field>
                <name>DDCD</name>
                <description>Delta data carrier detect</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>CTS</name>
                <description>Clear to send</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>DSR</name>
                <description>Data set ready</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>
                <name>RI</name>
                <description>Ring indicator</description>
                <bitRange>[6:6]</bitRange>
              </field>
              <field>
                <name>DCD</name>
                <description>Data carrier detect</description>
                <bitRange>[7:7]</bitRange>
              </field>
            </fields>
          </register>
          <register>
            <name>SCR</name>
            <description>Scratch Register</description>
            <addressOffset>0x7</addressOffset>
            <size>8</size>
            <resetValue>0x00</resetValue>
          </register>
        </cluster>
      </registers>
    </peripheral>

    <!-- ================================================================ -->
    <!-- I2C0 - Socket-backed I2C controller                             -->
    <!-- ================================================================ -->
    <peripheral>
      <name>I2C0</name>
      <description>ODP socket-backed I2C controller</description>
      <baseAddress>0x10001000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>I2C0</name>
        <description>I2C0 controller interrupt (PLIC source 2)</description>
        <value>2</value>
      </interrupt>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RX_RDY_IE</name>
              <description>RX-ready interrupt enable</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>CMD_DONE_IE</name>
              <description>Command-complete interrupt enable</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>CLEAR_FIFO</name>
              <description>Clear RX FIFO (write-1, self-clearing)</description>
              <bitRange>[2:2]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>RESET</name>
              <description>Soft reset (write-1, self-clearing)</description>
              <bitRange>[3:3]</bitRange>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RX_RDY</name>
              <description>RX FIFO not empty</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NAK</name>
              <description>Target NAKed / link dropped (write-1-to-clear)</description>
              <bitRange>[1:1]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>PROTO_ERR</name>
              <description>Illegal command ordering (write-1-to-clear)</description>
              <bitRange>[2:2]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>CMD_DONE</name>
              <description>Command completed (write-1-to-clear)</description>
              <bitRange>[3:3]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DATA</name>
          <description>Data register: read pops RX FIFO; write issues a command</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data byte (RX byte on read, TX/address byte on write)</description>
              <bitRange>[7:0]</bitRange>
            </field>
            <field>
              <name>CMD</name>
              <description>Command on write (0=START, 1=STOP, 2=RX, 3=TX)</description>
              <bitRange>[9:8]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <!-- ================================================================ -->
    <!-- I2C_TARGET - Socket-backed I2C target                           -->
    <!-- ================================================================ -->
    <peripheral>
      <name>I2C_TARGET</name>
      <description>ODP socket-backed I2C target</description>
      <baseAddress>0x10002000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>I2C_TARGET</name>
        <description>I2C target interrupt (PLIC source 3)</description>
        <value>3</value>
      </interrupt>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RX_ACK</name>
              <description>ACK pending RX byte and continue (write-1 strobe)</description>
              <bitRange>[0:0]</bitRange>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>RX_NAK</name>
              <description>NAK pending RX byte / reject (write-1 strobe)</description>
              <bitRange>[1:1]</bitRange>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>INT_START</name>
              <description>Interrupt enable: addressed (START)</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>INT_STOP</name>
              <description>Interrupt enable: STOP</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>INT_RX_RDY</name>
              <description>Interrupt enable: byte received</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>INT_TX</name>
              <description>Interrupt enable: TX done</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>RESET</name>
              <description>Recover / soft reset (write-1, self-clearing)</description>
              <bitRange>[6:6]</bitRange>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RW</name>
              <description>Transfer direction (1=controller read, 0=controller write)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>START</name>
              <description>Addressed: address matched (write-1-to-clear)</description>
              <bitRange>[1:1]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>STOP</name>
              <description>Controller sent STOP (write-1-to-clear)</description>
              <bitRange>[2:2]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>RESTART</name>
              <description>Repeated START, also sets START (write-1-to-clear)</description>
              <bitRange>[3:3]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>RX_RDY</name>
              <description>Byte in DATA awaiting strobe</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_DONE</name>
              <description>TX byte clocked and controller replied (write-1-to-clear)</description>
              <bitRange>[5:5]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>TX_NAK</name>
              <description>Last TX byte: 1=controller NAKed (done)</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADDR</name>
          <description>Target match address</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>7-bit address this target answers to</description>
              <bitRange>[6:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DATA</name>
          <description>Data register: RX byte on read, TX byte on write</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data byte</description>
              <bitRange>[7:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <!-- ================================================================ -->
    <!-- GPIO - Socket-backed bidirectional GPIO controller              -->
    <!-- ================================================================ -->
    <peripheral>
      <name>GPIO</name>
      <description>ODP socket-backed bidirectional GPIO controller (32 pins, one bit per pin)</description>
      <baseAddress>0x10003000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>GPIO</name>
        <description>GPIO shared interrupt (PLIC source 4)</description>
        <value>4</value>
      </interrupt>
      <registers>
        <register>
          <name>IN</name>
          <description>Input level (one bit per pin, driven by each pin's peer)</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IN</name>
              <description>Per-pin input level</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>OUT</name>
          <description>Output level (one bit per pin, driven to each pin's peer)</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>OUT</name>
              <description>Per-pin output level</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>IRQ_TRIG</name>
          <description>Interrupt trigger type (0 = level, 1 = edge)</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IRQ_TRIG</name>
              <description>Per-pin trigger select (0 = level, 1 = edge)</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>IRQ_POL</name>
          <description>Interrupt polarity (0 = low/falling, 1 = high/rising)</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IRQ_POL</name>
              <description>Per-pin polarity select (0 = low/falling, 1 = high/rising)</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>IRQ_EN</name>
          <description>Per-pin interrupt enable</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IRQ_EN</name>
              <description>Per-pin interrupt enable</description>
              <bitRange>[31:0]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>IRQ_PEND</name>
          <description>Per-pin interrupt pending (write-1-to-clear)</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>IRQ_PEND</name>
              <description>Per-pin interrupt pending (write-1-to-clear)</description>
              <bitRange>[31:0]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

  </peripherals>
</device>